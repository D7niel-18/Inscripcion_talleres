<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Inscripción al taller</title>
</head>

<body>
    <h1>Inscripción al taller</h1>

    <h2><%= taller.titulo %></h2>

    <p>Categoría: <%= taller.categoria %></p>

    <p>Nivel: <%= taller.nivel %></p>

    <p>Plazas restantes: <%= plazasRestantes %></p>

    <% if (typeof errores !== 'undefined' && errores.length > 0) { %>
        <ul>
            <% errores.forEach(error => { %>
                <li><%= error %></li>
            <% }); %>
        </ul>
    <% } %>

    <form action="/talleres/<%= taller.id %>/inscripcion" method="POST">
        <label for="nombre">Nombre:</label>
        <input type="text" id="nombre" name="nombre"
               value="<%= typeof datos !== 'undefined' && datos.nombre ? datos.nombre : '' %>" required>
        <br><br>
        <label for="email">Email:</label>
        <input type="email" id="email" name="email"
               value="<%= typeof datos !== 'undefined' && datos.email ? datos.email : '' %>" required>
        <br><br>
        <button type="submit">Inscribirme</button>
    </form>
</body>
</html>