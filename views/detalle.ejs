<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/styles.css">
    <title>Detalle del taller</title>
</head>
<body>

    <h1><%= taller.titulo %></h1>

    <p>ID: <%= taller.id %></p>

    <p>Categoría: <%= taller.categoria %></p>

    <p>Nivel: <%= taller.nivel %></p>

    <p>Plazas totales: <%= taller.plazas %></p>

    <p>Plazas restantes: <%= plazasRestantes %></p>

    <p>Estado: <%= estado %></p>
</body>
</html>